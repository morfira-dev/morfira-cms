{
  "name": "@morfira/admin",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.34.9",
  "type": "module",
  "scripts": {
    "api:types": "openapi-typescript ../back/openapi/openapi.yaml -o src/api/schema.d.ts",
    "boundaries": "node scripts/check-ui-boundaries.mjs",
    "build": "pnpm run api:types && tsc --noEmit && vite build",
    "check": "pnpm run boundaries && pnpm run test && pnpm run build",
    "dev": "vite",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@morfira-dev/wysiwyg-core": "1.15.0",
    "@morfira-dev/wysiwyg-plugins": "1.21.0",
    "@morfira-dev/wysiwyg-react": "1.15.0",
    "@mui/material": "^9.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "pnpm": {
    "overrides": {
      "vite>rolldown": "1.2.18"
    }
  }
}
