<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex,nofollow">
    <title>Page not found</title>
    <style>
        :root { color-scheme: light; font-family: Inter, ui-sans-serif, system-ui, sans-serif; color: #182230; }
        body { min-height: 100vh; margin: 0; display: grid; place-items: center; background: #f7f8fc; }
        main { max-width: 680px; padding: 48px 24px; text-align: center; }
        strong { display: block; color: #6941c6; font-size: 18px; }
        h1 { margin: 12px 0 16px; font-size: clamp(40px, 7vw, 72px); letter-spacing: -.04em; }
        p { color: #667085; font-size: 18px; line-height: 1.6; }
        a { display: inline-block; margin-top: 20px; color: #fff; background: #6941c6; padding: 12px 20px; border-radius: 10px; text-decoration: none; }
    </style>
</head>
<body>
    <main>
        <strong>404</strong>
        <h1>Page not found</h1>
        <p>The address may be outdated, or the page may have moved.</p>
        <a href="/">Return home</a>
    </main>
</body>
</html>
