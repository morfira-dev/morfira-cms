<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {% set seoTitle = page.seo.title ?: page.title %}
    {% set ogImage = page.seo.openGraphImageAssetId ? media_asset(page.seo.openGraphImageAssetId) : null %}
    <title>{{ seoTitle }}</title>
    {% if canonicalUrl %}<link rel="canonical" href="{{ canonicalUrl }}">{% endif %}
    {% if page.seo.description %}<meta name="description" content="{{ page.seo.description }}">{% endif %}
    <meta name="robots" content="{{ (notFound or page.seo.noIndex) ? 'noindex,nofollow' : 'index,follow' }}">
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ seoTitle }}">
    {% if canonicalUrl %}<meta property="og:url" content="{{ canonicalUrl }}">{% endif %}
    {% if page.seo.description %}<meta property="og:description" content="{{ page.seo.description }}">{% endif %}
    {% if ogImage %}
        <meta property="og:image" content="{{ publicSiteUrl ~ (ogImage.variants|last).url }}">
        <meta property="og:image:width" content="{{ ogImage.width }}">
        <meta property="og:image:height" content="{{ ogImage.height }}">
        <meta property="og:image:alt" content="{{ ogImage.defaultAlt }}">
        <meta name="twitter:card" content="summary_large_image">
    {% else %}
        <meta name="twitter:card" content="summary">
    {% endif %}
    <meta name="twitter:title" content="{{ seoTitle }}">
    {% if page.seo.description %}<meta name="twitter:description" content="{{ page.seo.description }}">{% endif %}
    <style>
        :root { color-scheme: light; font-family: Inter, ui-sans-serif, system-ui, sans-serif; color: #182230; }
        * { box-sizing: border-box; }
        body { margin: 0; background: #fff; }
        .site-header, .site-footer { padding: 20px 24px; background: #182230; color: #fff; }
        .site-header nav, .site-footer nav { max-width: 1200px; margin: 0 auto; display: flex; flex-wrap: wrap; gap: 20px; align-items: center; }
        .site-header a, .site-footer a { color: inherit; text-decoration: none; }
        .site-header a:hover, .site-footer a:hover { text-decoration: underline; }
        .page-shell--standard { max-width: 1200px; margin: 0 auto; }
        .page-shell--wide { width: 100%; }
        .hero { padding: clamp(72px, 10vw, 144px) 24px; background: #f4f6ff; text-align: center; }
        .hero h1 { max-width: 900px; margin: 0 auto; font-size: clamp(42px, 7vw, 84px); line-height: .98; letter-spacing: -.045em; }
        .hero p { max-width: 680px; margin: 28px auto 0; color: #52606d; font-size: 20px; line-height: 1.6; }
        .rich-text { max-width: 760px; margin: 0 auto; padding: 64px 24px; color: #344054; font-size: 18px; line-height: 1.75; }
        .rich-text > :first-child { margin-top: 0; }
        .rich-text > :last-child { margin-bottom: 0; }
        .rich-text h2, .rich-text h3, .rich-text h4 { color: #182230; line-height: 1.2; }
        .rich-text blockquote { margin-inline: 0; padding-left: 20px; border-left: 4px solid #c7d0ff; color: #52606d; }
        .rich-text pre { overflow-x: auto; padding: 16px; border-radius: 10px; background: #f2f4f7; }
        .rich-text a { color: #4158d0; }
        .image-block { max-width: 1200px; margin: 0 auto; padding: 32px 24px 64px; }
        .image-block img { display: block; width: 100%; height: auto; border-radius: 20px; }
        .image-block figcaption { margin-top: 12px; color: #667085; font-size: 14px; text-align: center; }
    </style>
</head>
<body class="theme-{{ page.layout.theme }} template-{{ page.layout.template }}">
    {% if headerNavigation %}
        <header class="site-header"><nav aria-label="{{ headerNavigation.name }}">
            {% for item in headerNavigation.items %}<a href="{{ item.href }}"{% if item.openInNewTab %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ item.label }}</a>{% endfor %}
        </nav></header>
    {% endif %}
    <main class="page-shell page-shell--{{ page.layout.template }}">
    {% for block in page.blocks %}
        {% if block.type == 'hero' %}
            <section class="hero">
                <h1>{{ block.data.heading }}</h1>
                {% if block.data.text is defined and block.data.text %}<p>{{ block.data.text }}</p>{% endif %}
            </section>
        {% elseif block.type == 'richText' %}
            <section class="rich-text">{{ block.data.content|cms_rich_text }}</section>
        {% elseif block.type == 'image' %}
            {% set asset = media_asset(block.data.assetId) %}
            {% if asset %}
                <figure class="image-block">
                    <img
                        src="{{ asset.variants|last.url }}"
                        srcset="{% for variant in asset.variants %}{{ variant.url }} {{ variant.width }}w{% if not loop.last %}, {% endif %}{% endfor %}"
                        sizes="(max-width: 1248px) calc(100vw - 48px), 1200px"
                        width="{{ asset.width }}"
                        height="{{ asset.height }}"
                        alt="{{ block.data.alt }}"
                        loading="lazy"
                        decoding="async"
                    >
                    {% if block.data.caption is defined and block.data.caption %}<figcaption>{{ block.data.caption }}</figcaption>{% endif %}
                </figure>
            {% endif %}
        {% endif %}
    {% endfor %}
    </main>
    {% if footerNavigation %}
        <footer class="site-footer"><nav aria-label="{{ footerNavigation.name }}">
            {% for item in footerNavigation.items %}<a href="{{ item.href }}"{% if item.openInNewTab %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ item.label }}</a>{% endfor %}
        </nav></footer>
    {% endif %}
</body>
</html>
