<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ entry.title }}</title>
    <style>
        :root { color-scheme: light; font-family: Inter, ui-sans-serif, system-ui, sans-serif; color: #182230; }
        * { box-sizing: border-box; }
        body { margin: 0; background: #f8fafc; }
        main { width: min(880px, calc(100% - 32px)); margin: 48px auto; padding: clamp(24px, 6vw, 64px); background: #fff; border: 1px solid #e4e7ec; border-radius: 24px; }
        h1 { margin: 0 0 40px; font-size: clamp(36px, 7vw, 64px); line-height: 1; letter-spacing: -.04em; }
        dl { display: grid; gap: 28px; margin: 0; }
        dt { margin-bottom: 8px; color: #667085; font-size: 13px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
        dd { margin: 0; color: #344054; font-size: 18px; line-height: 1.65; white-space: pre-wrap; }
        dd.rich-text { white-space: normal; }
        img { display: block; width: 100%; height: auto; border-radius: 16px; }
    </style>
</head>
<body>
<main>
    <h1>{{ entry.title }}</h1>
    <dl>
        {% for field in entry.contentType.fields %}
            {% if entry.values[field.key] is defined and entry.values[field.key] is not null %}
                {% set value = entry.values[field.key] %}
                <div>
                    <dt>{{ field.label }}</dt>
                    <dd{% if field.type == 'richText' %} class="rich-text"{% endif %}>
                        {% if field.type == 'media' %}
                            {% set asset = media_asset(value) %}
                            {% if asset %}
                                <img src="{{ asset.variants|last.url }}" srcset="{% for variant in asset.variants %}{{ variant.url }} {{ variant.width }}w{% if not loop.last %}, {% endif %}{% endfor %}" sizes="(max-width: 880px) calc(100vw - 64px), 752px" width="{{ asset.width }}" height="{{ asset.height }}" alt="{{ asset.defaultAlt }}" loading="lazy" decoding="async">
                            {% endif %}
                        {% elseif field.type == 'relation' and field.multiple|default(false) %}
                            <ol>
                                {% for targetId in value %}<li>{{ targetId }}</li>{% endfor %}
                            </ol>
                        {% elseif field.type == 'richText' %}
                            {{ value|cms_rich_text }}
                        {% elseif field.type == 'boolean' %}
                            {{ value ? 'Yes' : 'No' }}
                        {% else %}
                            {{ value }}
                        {% endif %}
                    </dd>
                </div>
            {% endif %}
        {% endfor %}
    </dl>
</main>
</body>
</html>
