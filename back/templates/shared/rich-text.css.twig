        .rich-text { overflow-x: auto; }
        .rich-text table { border-collapse: collapse; }
        .rich-text th, .rich-text td { min-width: 2.5rem; padding: .4rem .65rem; border: 1px solid #d0d5dd; }
        .rich-text th { background: #f2f4f7; }
        .rich-text img { max-width: 100%; height: auto; }
        .rich-text figure { margin-inline: 0; }
        .rich-text figcaption { font-size: .875em; }
        .rich-text li[data-checklist-checked="true"]::marker { content: "☑ "; }
        .rich-text li[data-checklist-checked="false"]::marker { content: "☐ "; }
