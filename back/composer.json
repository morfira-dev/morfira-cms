{
  "name": "morfira/cms",
  "description": "A lightweight, scalable and extensible content management system for websites, applications and APIs.",
  "type": "project",
  "require": {
    "php": "^8.4",
    "doctrine/doctrine-bundle": "^3.3",
    "doctrine/doctrine-migrations-bundle": "^4.0",
    "symfony/cache": "^8.1",
    "symfony/config": "^8.1",
    "symfony/console": "^8.1",
    "symfony/dependency-injection": "^8.1",
    "symfony/doctrine-bridge": "^8.1",
    "symfony/dotenv": "^8.1",
    "symfony/error-handler": "^8.1",
    "symfony/event-dispatcher": "^8.1",
    "symfony/filesystem": "^8.1",
    "symfony/finder": "^8.1",
    "symfony/framework-bundle": "^8.1",
    "symfony/http-foundation": "^8.1",
    "symfony/http-kernel": "^8.1",
    "symfony/rate-limiter": "^8.1",
    "symfony/routing": "^8.1",
    "symfony/runtime": "^8.1",
    "symfony/security-bundle": "^8.1",
    "symfony/security-csrf": "^8.1",
    "symfony/stopwatch": "^8.1",
    "symfony/twig-bundle": "^8.1",
    "twig/twig": "^3.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.0",
    "symfony/browser-kit": "^8.1",
    "symfony/css-selector": "^8.1",
    "symfony/dom-crawler": "^8.1"
  },
  "autoload": {
    "psr-4": {
      "Cms\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Cms\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/runtime": true
    },
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "scripts": {
    "analyse": "phpstan analyse --memory-limit=512M",
    "check": [
      "@test",
      "@analyse"
    ],
    "serve": "php -S 127.0.0.1:8080 -t public public/index.php",
    "test": "phpunit"
  }
}
